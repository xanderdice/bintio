{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "org.bintio.app",
  "applicationName": "BINTIO",
  "description": "BINTIO",
  "author": "BINTIO",
  "copyright": "BINTIO - codigo MIT",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 8788,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [],
  "globalVariables": {
    "BINTIO_DESKTOP": true
  },
  "modes": {
    "window": {
      "title": "BINTIO",
      "width": 1120,
      "height": 760,
      "minWidth": 360,
      "minHeight": 480,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/dist/icon-512.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "useSavedState": false,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "bintio",
    "resourcesPath": "/dist/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/bin/neutralino.js",
    "binaryVersion": "5.5.0",
    "clientVersion": "5.5.0",
    "distributionPath": "/salida/"
  }
}
